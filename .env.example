# REQUIRED for writing. Posts and outreach copy are generated ONLY by AI (OpenAI).
# Without this key, content-generation endpoints return a clear error (no templated fallback).
# Images still render locally as SVG when unset, and upgrade to OpenAI images when set.
OPENAI_API_KEY=

# Optional overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-1

# LinkedIn auto-publishing.
# When BOTH are set, posts are published for real via the LinkedIn UGC Posts API.
# When unset, the platform runs in safe "simulation" mode (jobs flow end-to-end
# with a simulated post URL, so scheduling/approval/retry all work without posting).
# AUTHOR_URN is like "urn:li:person:XXXX" or "urn:li:organization:XXXX".
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
# LINKEDIN_API_BASE=https://api.linkedin.com/v2

# Optional shared secret for the scheduled pipeline endpoint (/api/cron/run).
# When set, cron requests must include ?secret=... or an x-cron-secret header.
CRON_SECRET=
